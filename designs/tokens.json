    "nav-active": {
      "light": "#1B2F57",
      "dark": "#1B2F57",
      "use": "Mục menu đang chọn."
    },
    "nav-accent": {
      "light": "#5B8CFF",
      "dark": "#5B8CFF",
      "use": "Vạch mục đang chọn."
    },
    "ok": {
      "light": "#027A48",
      "dark": "#4ADE80",
      "use": "Khớp, thành công."
    },
    "ok-soft": {
      "light": "#E8F8F0",
      "dark": "#0F2E1C",
      "use": "Nền chip ok."
    },
    "crit": {
      "light": "#B42318",
      "dark": "#F87171",
      "use": "Lệch, lỗi, PROD, xóa."
    },
    "crit-soft": {
      "light": "#FDECEC",
      "dark": "#3B1418",
      "use": "Nền lỗi, ô lệch."
    },
    "warn": {
      "light": "#B54708",
      "dark": "#FB923C",
      "use": "Thiếu trong DB, cảnh báo, UAT."
    },
    "warn-soft": {
      "light": "#FFF4E5",
      "dark": "#3A2210",
      "use": "Nền cảnh báo."
    },
    "purple": {
      "light": "#5925DC",
      "dark": "#C4B5FD",
      "use": "Thiếu trong Excel, measure."
    },
    "purple-soft": {
      "light": "#F1EDFF",
      "dark": "#2A1F4D",
      "use": "Nền chip purple."
    },
    "off": {
      "light": "#475467",
      "dark": "#A3B1C6",
      "use": "Không nhất quán, Draft, đã tắt."
