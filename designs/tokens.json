{
  "version": 2,
  "meta": {
    "name": "ReconHub",
    "note": "Bảng điều khiển dày dữ liệu, xanh dương, mặt trắng, viền mảnh, thanh bên tối."
  },
  "font": {
    "ui": "\"Inter\", \"Segoe UI\", Roboto, Arial, sans-serif",
    "mono": "\"JetBrains Mono\", Consolas, ui-monospace, monospace"
  },
  "color": {
    "bg": {
      "light": "#F5F7FB",
      "dark": "#0B1220",
      "use": "Nền vùng nội dung."
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#111A2E",
      "use": "Mặt thẻ, bảng, ô nhập, thanh trên, ngăn kéo."
    },
    "surface-2": {
      "light": "#F8FAFC",
      "dark": "#18233A",
      "use": "Tiêu đề bảng, hover dòng, vùng thả file."
    },
    "line": {
      "light": "#E3E8F0",
      "dark": "#26334D",
      "use": "Viền thẻ, chia dòng bảng."
    },
    "line-strong": {
      "light": "#667085",
      "dark": "#7C8AA5",
      "use": "Viền ô nhập, nút phụ (≥ 4,5:1)."
    },
    "ink": {
      "light": "#1D2939",
      "dark": "#E2E8F0",
      "use": "Chữ chính."
    },
    "ink-soft": {
      "light": "#667085",
      "dark": "#A3B1C6",
      "use": "Chữ phụ, nhãn cột."
    },
    "primary": {
      "light": "#2563EB",
      "dark": "#60A5FA",
      "use": "Nút chính, link, bước/tab đang chọn."
    },
    "primary-hover": {
      "light": "#1D4ED8",
      "dark": "#93C5FD",
      "use": "Hover nút chính."
