    "off-soft": {
      "light": "#F2F4F7",
      "dark": "#1E293B",
      "use": "Nền chip off."
    },
    "info": {
      "light": "#1D4ED8",
      "dark": "#93C5FD",
      "use": "Đang chạy, thông tin."
    },
    "info-soft": {
      "light": "#EAF1FF",
      "dark": "#14223F",
      "use": "Nền thông tin."
    },
    "code-bg": {
      "light": "#0F1B33",
      "dark": "#060B16",
      "use": "Nền khối mã."
    },
    "code-ink": {
      "light": "#D6E2FF",
      "dark": "#D6E2FF",
      "use": "Chữ khối mã."
    }
  },
  "type": {
    "screen-title": {
      "size": 22,
      "line": 1.3,
      "weight": 700,
      "use": "H1 màn."
    },
    "section-title": {
      "size": 15,
      "line": 1.4,
      "weight": 600,
      "use": "Tiêu đề khối."
    },
    "kpi-figure": {
      "size": 24,
      "line": 1.2,
      "weight": 700,
      "use": "Số KpiCard."
    },
    "body": {
      "size": 14,
      "line": 1.5,
      "weight": 400,
      "use": "Chữ mặc định."
    },
    "body-sm": {
      "size": 13,
      "line": 1.45,
      "weight": 400,
      "use": "Gợi ý, ô phụ."
    },
    "label": {
      "size": 12,
      "line": 1.4,
      "weight": 600,
      "use": "Nhãn ô nhập, tiêu đề cột."
    },
    "button": {
      "size": 14,
      "line": 1.2,
      "weight": 600,
      "use": "Chữ nút."
    },
    "chip": {
      "size": 12,
      "line": 1.4,
      "weight": 600,
      "use": "Chip."
    },
    "caption": {
      "size": 11,
      "line": 1.4,
      "weight": 700,
      "use": "Nhãn nhóm menu."
    },
    "code": {
      "size": 12,
      "line": 1.45,
      "weight": 500,
      "use": "Mã, SQL."
    }
  },
  "space": {
    "space-4": 4,
    "space-6": 6,
    "space-8": 8,
    "space-10": 10,
    "space-12": 12,
    "space-14": 14,
    "space-16": 16,
    "space-18": 18,
    "space-20": 20,
    "space-24": 24,
    "space-28": 28,
    "space-32": 32
  },
  "radius": {
    "radius-chip": 20,
    "radius-control": 8,
    "radius-card": 12,
    "radius-step": 12,
    "radius-pill": 999
  },
  "shadow": {
    "shadow-popover": {
      "light": "0 6px 18px rgba(15,23,42,.12)",
      "dark": "0 6px 18px rgba(0,0,0,.45)"
    },
    "shadow-drawer": {
      "light": "-8px 0 30px rgba(15,23,42,.12)",
      "dark": "-8px 0 30px rgba(0,0,0,.55)"
    }
  },
  "size": {
    "size-nav": 232,
    "size-nav-collapsed": 64,
    "size-header": 56,
    "size-control": 36,
    "size-control-sm": 28,
    "size-drawer": 540,
    "size-login": 400
  },
  "status": {
    "MATCHED": [
      "ok",
      "Khớp",
      "check"
    ],
    "MISMATCH": [
      "crit",
      "Lệch giá trị",
      "not-equal"
    ],
    "MISSING_IN_DB": [
      "warn",
      "Thiếu trong DB",
      "database-x"
    ],
    "MISSING_IN_EXCEL": [
      "purple",
      "Thiếu trong Excel",
      "file-x"
    ],
    "INCONSISTENT": [
      "off",
      "Không nhất quán",
      "shuffle"
    ],
    "DUPLICATE": [
      "warn",
      "Trùng khóa",
      "copy"
    ],
    "INVALID": [
      "crit",
      "Không hợp lệ",
      "alert-triangle"
    ]
  }
}