APP_ENV=dev                 # dev | test | uat | prod

# RECON_APP. Mặc định SQLite (đường dẫn tương đối tính từ thư mục dự án).
RECON_DB_URL=sqlite:///data/recon_app.db
# Sau khi chuyển sang Oracle (spec 08):
# RECON_DB_URL=oracle+oracledb://RECON_APP:<mật khẩu>@<host>:1521/?service_name=<service>

# Khóa mã hóa mật khẩu Data Source (Fernet, 32 byte base64) và khóa phiên Flask
RECON_SECRET_KEY=change_me
FLASK_SECRET_KEY=change_me

# Đăng nhập
SESSION_HOURS=8
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

# Thư mục dữ liệu
RECON_STORAGE_DIR=./storage
BACKUP_DIR=./backup

# Cảnh báo dữ liệu tạm (chỉ cảnh báo, không tự xóa)
TEMP_WARN_GB=5
TEMP_WARN_DAYS=30
RESULT_RETENTION_DAYS=0     # 0 = không tự xóa kết quả

# Dash / worker
DASH_PORT=8050
DASH_DEBUG=true
WORKER_POLL_SECONDS=2
WORKER_STUCK_MINUTES=15
RUN_MAX_ROWS=1000000
RUN_DB_CALL_TIMEOUT_SECONDS=600   # rộng hơn khi chạy qua VPN

# Test tích hợp Oracle (qua VPN). Thiếu biến thì test Oracle tự skip.
ORACLE_TEST_DSN=            # host:1521/service
ORACLE_TEST_SRC_USER=       # user chỉ đọc bảng nguồn test (RECON_SRC_RO)
ORACLE_TEST_SRC_PASSWORD=
ORACLE_TEST_SRC_SCHEMA=     # schema chứa SRC_FACT_INVOICE_DTP (RECON_SRC)
ORACLE_TEST_APP_USER=       # schema đích thử chuyển RECON_APP (RECON_APP_TEST)
ORACLE_TEST_APP_PASSWORD=
